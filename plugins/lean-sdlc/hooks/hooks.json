{
  "description": "Restore Lean-SDLC session state and validate Agent spawn arguments.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/skills/lean-sdlc/scripts/session_state.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\skills\\lean-sdlc\\scripts\\session_state.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/skills/lean-sdlc/scripts/spawn_guard.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\skills\\lean-sdlc\\scripts\\spawn_guard.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
