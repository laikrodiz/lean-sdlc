{
  "description": "Provide a stable Lean-SDLC task owner for each Codex task.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/skills/lean-sdlc/scripts/session_owner.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\skills\\lean-sdlc\\scripts\\session_owner.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
